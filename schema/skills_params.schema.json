{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["skills"],
  "properties": {
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "levels"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["level", "effects"],
              "properties": {
                "level": { "type": "integer", "minimum": 1 },
                "effects": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "op": { "type": "string", "enum": ["add", "mul"] },
                      "value": { "type": "integer" },
                      "factor": { "type": "number" }
                    },
                    "required": ["op"],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
