{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/murakotaro4/MS_data/schema/custom_parts.schema.json",
  "title": "MS_data custom_parts",
  "description": "atwiki カスタムパーツ一覧（pages/263）から生成するパーツ一覧。1要素 = パーツ1種類の1LV。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["name", "level", "rarity", "category", "wiki_url"],
    "additionalProperties": false,
    "properties": {
      "name": {"description": "パーツ名（ページの表記のまま）", "type": "string", "minLength": 1},
      "level": {"description": "パーツのLV", "type": "integer", "minimum": 1},
      "rarity": {"description": "レア度（☆の数）", "type": "integer", "minimum": 1, "maximum": 5},
      "category": {"description": "系統", "enum": ["攻撃系", "防御系", "移動系", "補助系", "特殊系"]},
      "wiki_url": {"description": "出典ページ", "type": "string", "pattern": "^https://w\\.atwiki\\.jp/battle-operation2/pages/\\d+\\.html$"}
    }
  }
}
