{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["owners"],
  "properties": {
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["series", "base"],
        "properties": {
          "series": { "type": "string", "minLength": 1 },
          "base": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "level"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "level": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
