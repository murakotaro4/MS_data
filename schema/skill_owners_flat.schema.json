{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["owners"],
  "properties": {
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "skill_level", "series", "ms_level"],
        "properties": {
          "skill": { "type": "string", "minLength": 1 },
          "skill_level": { "type": "integer", "minimum": 1 },
          "series": { "type": "string", "minLength": 1 },
          "ms_level": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
