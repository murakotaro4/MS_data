{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/murakotaro4/MS_data/schema/reports/auto_review.schema.json",
  "title": "MS_data auto review report",
  "type": "object",
  "required": ["schema_version", "generated_at", "report_date", "source_run_id", "pr_number", "head_ref", "head_sha", "status", "stop_reason", "merge_ok", "merged", "review"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "generated_at": {"type": "string", "minLength": 1},
    "report_date": {"type": "string", "pattern": "^\\d{8}$"},
    "source_run_id": {"type": "string", "minLength": 1},
    "pr_number": {"type": "string", "minLength": 1},
    "head_ref": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["stopped", "merge_ready", "merge_failed", "merged"]},
    "stop_reason": {"type": "string", "minLength": 1},
    "merge_ok": {"type": "boolean"},
    "merged": {"type": "boolean"},
    "merge_outcome": {"type": "string"},
    "findings": {"type": ["integer", "null"], "minimum": 0},
    "review_complete": {"type": "boolean"},
    "review": {
      "type": "object",
      "required": ["responded", "attempts_used", "max_attempts", "attempt_timeout_seconds", "trigger_comment_ids", "first_trigger_created_at"],
      "additionalProperties": true,
      "properties": {
        "responded": {"type": "boolean"},
        "attempts_used": {"type": ["integer", "null"], "minimum": 0},
        "max_attempts": {"type": ["integer", "null"], "minimum": 0},
        "attempt_timeout_seconds": {"type": ["integer", "null"], "minimum": 0},
        "trigger_comment_ids": {"type": "array", "items": {"type": "string"}},
        "first_trigger_created_at": {"type": "string"}
      }
    }
  }
}
