{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "msData array schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "MS名": { "type": "string", "pattern": ".+_LV\\d+$" },
      "属性": { "type": "string", "enum": ["汎用", "強襲", "支援"] },
      "コスト": { "type": "integer", "minimum": 0, "maximum": 2000 },
      "HP": { "type": "integer", "minimum": 0 },
      "スピード": { "type": "integer", "minimum": 0 },
      "スピード_変形時": { "type": "integer", "minimum": 0 },
      "スラスター": { "type": "integer", "minimum": 0 },
      "高速移動": { "type": "integer", "minimum": 0 },
      "高速移動_変形時": { "type": "integer", "minimum": 0 },
      "射撃補正": { "type": "integer", "minimum": 0 },
      "格闘補正": { "type": "integer", "minimum": 0 },
      "耐ビーム補正": { "type": "integer", "minimum": 0 },
      "耐実弾補正": { "type": "integer", "minimum": 0 },
      "耐格闘補正": { "type": "integer", "minimum": 0 },
      "近スロット": { "type": "integer", "minimum": 0 },
      "中スロット": { "type": "integer", "minimum": 0 },
      "遠スロット": { "type": "integer", "minimum": 0 },
      "旋回_地上_通常時": { "type": "integer", "minimum": 0 },
      "旋回_地上_変形時": { "type": "integer", "minimum": 0 },
      "旋回_宇宙_通常時": { "type": "integer", "minimum": 0 },
      "旋回_宇宙_変形時": { "type": "integer", "minimum": 0 },
      "カウンター": { "type": "string" },
      "再出撃時間": { "type": "integer", "minimum": 0 },
      "格闘判定力": { "type": ["string", "null"] },
      "レアリティ": { "type": "string" },
      "必要階級": { "type": "string" },
      "必要DP": { "type": "integer", "minimum": 0 },
      "必要リサイクルチケット": { "type": "integer", "minimum": 0 },
      "fullst": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "level": { "type": "integer", "minimum": 0 },
            "points": { "type": ["integer", "null"] }
          },
          "required": ["name", "level"],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "MS名",
      "属性",
      "コスト",
      "HP",
      "スピード",
      "スラスター",
      "高速移動",
      "射撃補正",
      "格闘補正",
      "耐ビーム補正",
      "耐実弾補正",
      "耐格闘補正",
      "近スロット",
      "中スロット",
      "遠スロット",
      "旋回_地上_通常時"
    ],
    "additionalProperties": true
  }
}
